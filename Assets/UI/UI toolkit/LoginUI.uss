#background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('project://database/Assets/Background.png');  /* Ìæ»»ÎªÄãµÄÍ¼Æ¬Â·¾¶£¬»òÍÏÈë UI Builder */
    background-size: cover;  /* ¸²¸ÇÈ«ÆÁ */
    background-position: center;
    justify-content: center;
    align-items: center;
}

#login-panel {
    width: 400px;
    height: 300px;
    background-color: rgba(0, 0, 0, 0.7);  /* °ëÍ¸Ã÷ºÚÉ«±³¾° */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    border-radius: 10px;
}

TextField {
    width: 300px;
    height: 40px;
    margin-bottom: 20px;
    font-size: 18px;
}

#login-button {
    width: 200px;
    height: 50px;
    font-size: 20px;
    background-color: #4CAF50;
}

#error-label {
    color: red;
    margin-top: 10px;
    display: none;  /* ³õÊ¼Òþ²Ø */
}